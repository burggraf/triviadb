# Copy to .env only if you do not already have one. Never commit real keys.
GEMINI_API_KEY="key-one,key-two"

# Optional: comma-delimited project labels, aligned with the keys above.
# Keys from one project share quotas. A 429 cools down all keys in that group.
# GEMINI_KEY_PROJECTS="project-a,project-a"

# Use `python3 -m triviadb models` to check availability for your account.
GEMINI_WRITER_MODEL="gemini-3.5-flash-lite"
GEMINI_REVIEWER_MODEL="gemini-3.5-flash"

# Optional environment variable for source requests (set/export in your shell):
# TRIVIADB_USER_AGENT="TriviaDB/0.1 (contact: you@example.com)"
